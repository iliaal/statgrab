 __sg_private char *sg_f_read_line(FILE *f, char *linebuf, size_t buf_size, const char *string);
 #endif
 
+#if HAVE_REGEX_H && defined(__GLIBC__)
+/* statgrab: call glibc's POSIX regex functions even when the host program
